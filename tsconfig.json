{
  "extends": "./tsconfig.base.json",
  // The app's tsconfig since #3, when apps/web moved to the repo root. It also
  // covers the two directories that belong to the repo rather than to the app:
  // `scripts/reset.ts` (#23) and the end-to-end tests in `test/` that drive it.
  //
  // Every workspace under `apps/` and `packages/` has its own tsconfig, and the
  // root `typecheck` reaches them with `--filter '*'`, so they are excluded
  // here. `docs/` and `tools/` were never in the root's scope.
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "apps", "packages", "docs", "tools"]
}
